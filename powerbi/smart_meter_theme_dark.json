        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E6ECFF"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#13224A"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E6ECFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#182B5A"
              }
            }
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6ECFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#182B5A"
              }
            }
          }
        ]
      }
